			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Status 200', function () {",
							"  pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Body berupa array dengan field sesuai dokumentasi', function () {",
							"  const data = pm.response.json();",
							"  pm.expect(data).to.be.an('array');",
							"  pm.expect(data[0]).to.have.all.keys('id', 'name', 'category', 'regionId');",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{local_url}}/v2/destinations",
					"host": [
						"{{local_url}}"
					],
					"path": [
						"v2",
						"destinations"
					]
				}
			},
			"response": []
		},
